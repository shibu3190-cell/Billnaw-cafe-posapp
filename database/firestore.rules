rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Multi-Tenant Security & Dual-Path Compatibility
    function isValidTenant(id) {
      return id is string && id.size() >= 3 && !id.matches('^\\s+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function matchesTenantId(tenantId) {
      return ('storeCode' in request.auth.token && request.auth.token.storeCode is string && request.auth.token.storeCode == tenantId) ||
             ('cafe_id' in request.auth.token && request.auth.token.cafe_id is string && request.auth.token.cafe_id == tenantId) ||
             ('shopId' in request.auth.token && request.auth.token.shopId is string && request.auth.token.shopId == tenantId);
    }

    function matchesOwnerEmail() {
      return (resource != null && 'ownerEmail' in resource.data && 'email' in request.auth.token && request.auth.token.email is string && resource.data.ownerEmail == request.auth.token.email) ||
             (request.resource != null && 'ownerEmail' in request.resource.data && 'email' in request.auth.token && request.auth.token.email is string && request.resource.data.ownerEmail == request.auth.token.email);
    }

    function isTenantStaff(tenantId) {
      return isValidTenant(tenantId) && isAuthenticated() && (
        matchesTenantId(tenantId) ||
        matchesOwnerEmail()
      );
    }

    function isTenantAdmin(tenantId) {
      return isTenantStaff(tenantId) && (
        ('role' in request.auth.token && request.auth.token.role is string && (request.auth.token.role == 'admin' || request.auth.token.role == 'owner')) ||
        ('isOwner' in request.auth.token && request.auth.token.isOwner == true) ||
        matchesOwnerEmail()
      );
    }

    function isWithin30DayEditWindow() {
      return !('createdAt' in resource.data) || 
             (resource.data.createdAt is timestamp && request.time < resource.data.createdAt + duration.value(30, 'd')) ||
             (resource.data.created_at is timestamp && request.time < resource.data.created_at + duration.value(30, 'd'));
    }

    // ROOT HARDWARE DEVICES COLLECTION — STRICT ZERO-CLIENT ACCESS GATE
    // Only trusted Firebase Admin SDK (Cloud Functions) can read or modify.
    // Client SDK direct read and write is completely forbidden.
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // Modern Multi-Tenant Root Collection (/cafes/{cafeId})
    match /cafes/{cafeId} {
      allow read: if isTenantStaff(cafeId);
      allow write: if isTenantAdmin(cafeId);

      // INVOICE LEDGER — STRICT ANTI-TAMPERING INVARIANT & 30-DAY EDIT LOCK
      match /invoices/{invoiceId} {
        allow read, create: if isTenantStaff(cafeId);
        
        // PHYSICAL DELETION IS PERMANENTLY FORBIDDEN
        allow delete: if false;
        
        // CANCEL / VOID MUTATION AUDIT
        allow update: if isTenantStaff(cafeId) &&
          isWithin30DayEditWindow() &&
          resource.data.status == 'PAID' &&
          request.resource.data.status == 'VOID' &&
          request.resource.data.void_audit.void_reason is string &&
          request.resource.data.void_audit.voided_by_staff_id is string &&
          request.resource.data.void_audit.voided_at is string;
      }

      // KITCHEN ORDER TICKETS (KOT)
      match /kot/{kotId} {
        allow read, create: if isTenantStaff(cafeId);
        allow delete: if false; // Status transitions only
        allow update: if isTenantStaff(cafeId);
      }
      match /kots/{kotId} {
        allow read, create: if isTenantStaff(cafeId);
        allow delete: if false; // Status transitions only
        allow update: if isTenantStaff(cafeId);
      }

      // DISTRIBUTED CLOUD PRINT RELAY — EXCLUSIVELY FOR REMOTE KOT PRINTING
      match /print_queue/{jobId} {
        allow read: if isTenantStaff(cafeId);
        allow create: if isTenantStaff(cafeId) &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status == 'queued';
        allow update: if isTenantStaff(cafeId) &&
          resource.data.jobType == 'KOT' &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'processing', 'printed', 'failed'];
        allow delete: if isTenantAdmin(cafeId);
      }

      // INDIVIDUAL TABLES (Row-level concurrency)
      match /tables/{tableId} {
        allow read: if isTenantStaff(cafeId);
        allow write: if isTenantStaff(cafeId);
      }

      // DEVICE PAIRING & AUTHORIZATION
      match /devices/{deviceId} {
        allow read: if isTenantStaff(cafeId);
        allow write: if isTenantStaff(cafeId);
      }

      // LIVE STAFF SESSIONS & PRESENCE
      match /sessions/{sessionId} {
        allow read: if isTenantStaff(cafeId);
        allow write: if isTenantStaff(cafeId);
      }
      match /staffSessions/{staffId} {
        allow read: if isTenantStaff(cafeId);
        allow write: if isTenantStaff(cafeId);
      }

      // DISTRIBUTED CLOUD PRINT RELAY (CamelCase alias)
      match /printQueue/{jobId} {
        allow read: if isTenantStaff(cafeId);
        allow create: if isTenantStaff(cafeId) &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'pending'];
        allow update: if isTenantStaff(cafeId) &&
          resource.data.jobType == 'KOT' &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'pending', 'processing', 'printed', 'failed'];
        allow delete: if isTenantAdmin(cafeId);
      }

      // STAFF DIRECTORY & PIN AUTH
      match /staff/{staffId} {
        allow read: if isTenantStaff(cafeId);
        allow write: if isTenantAdmin(cafeId);
      }

      // OPERATIONAL SUBCOLLECTIONS
      match /menu/{menuId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /inventory/{itemId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /customers/{customerId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /expenses/{expenseId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /settings/{settingId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantAdmin(cafeId); }
      match /counters/{counterId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /khata/{khataId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /history/{historyId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /raw_materials/{matId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /sub_recipes/{recId} { allow read: if isTenantStaff(cafeId); allow write: if isTenantStaff(cafeId); }
      match /reports/{reportId} { allow read, write: if isTenantStaff(cafeId); }
      match /daily_summaries/{summaryId} { allow read, write: if isTenantStaff(cafeId); }
      match /marketing_logs/{logId} { allow read, write: if isTenantStaff(cafeId); }
    }

    // Aligned Dual-Path Backward-Compatibility Paths (/shops/{shopId})
    match /shops/{shopId} {
      allow read: if isTenantStaff(shopId);
      allow write: if isTenantAdmin(shopId);

      // INVOICE LEDGER — STRICT ANTI-TAMPERING INVARIANT & 30-DAY EDIT LOCK
      match /invoices/{invoiceId} {
        allow read, create: if isTenantStaff(shopId);
        allow delete: if false;
        allow update: if isTenantStaff(shopId) &&
          isWithin30DayEditWindow() &&
          resource.data.status == 'PAID' &&
          request.resource.data.status == 'VOID' &&
          request.resource.data.void_audit.void_reason is string &&
          request.resource.data.void_audit.voided_by_staff_id is string &&
          request.resource.data.void_audit.voided_at is string;
      }

      // KITCHEN ORDER TICKETS (KOT)
      match /kot/{kotId} {
        allow read, create: if isTenantStaff(shopId);
        allow delete: if false;
        allow update: if isTenantStaff(shopId);
      }
      match /kots/{kotId} {
        allow read, create: if isTenantStaff(shopId);
        allow delete: if false;
        allow update: if isTenantStaff(shopId);
      }

      // DISTRIBUTED CLOUD PRINT RELAY — EXCLUSIVELY FOR REMOTE KOT PRINTING
      match /print_queue/{jobId} {
        allow read: if isTenantStaff(shopId);
        allow create: if isTenantStaff(shopId) &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status == 'queued';
        allow update: if isTenantStaff(shopId) &&
          resource.data.jobType == 'KOT' &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'processing', 'printed', 'failed'];
        allow delete: if isTenantAdmin(shopId);
      }

      match /tables/{tableId} {
        allow read: if isTenantStaff(shopId);
        allow write: if isTenantStaff(shopId);
      }

      // DEVICE PAIRING & AUTHORIZATION
      match /devices/{deviceId} {
        allow read: if isTenantStaff(shopId);
        allow write: if isTenantStaff(shopId);
      }

      // LIVE STAFF SESSIONS & PRESENCE
      match /sessions/{sessionId} {
        allow read: if isTenantStaff(shopId);
        allow write: if isTenantStaff(shopId);
      }
      match /staffSessions/{staffId} {
        allow read: if isTenantStaff(shopId);
        allow write: if isTenantStaff(shopId);
      }

      // DISTRIBUTED CLOUD PRINT RELAY (CamelCase alias)
      match /printQueue/{jobId} {
        allow read: if isTenantStaff(shopId);
        allow create: if isTenantStaff(shopId) &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'pending'];
        allow update: if isTenantStaff(shopId) &&
          resource.data.jobType == 'KOT' &&
          request.resource.data.jobType == 'KOT' &&
          !('invoice' in request.resource.data) &&
          !('billNo' in request.resource.data) &&
          !('amount' in request.resource.data) &&
          !('final_payable_paise' in request.resource.data) &&
          request.resource.data.status in ['queued', 'pending', 'processing', 'printed', 'failed'];
        allow delete: if isTenantAdmin(shopId);
      }

      // STAFF DIRECTORY & PIN AUTH
      match /staff/{staffId} {
        allow read: if isTenantStaff(shopId);
        allow write: if isTenantAdmin(shopId);
      }

      // OPERATIONAL SUBCOLLECTIONS
      match /menu/{menuId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /inventory/{itemId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /customers/{customerId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /expenses/{expenseId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /settings/{settingId} { allow read: if isTenantStaff(shopId); allow write: if isTenantAdmin(shopId); }
      match /counters/{counterId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /khata/{khataId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /history/{historyId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /raw_materials/{matId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /sub_recipes/{recId} { allow read: if isTenantStaff(shopId); allow write: if isTenantStaff(shopId); }
      match /reports/{reportId} { allow read, write: if isTenantStaff(shopId); }
      match /daily_summaries/{summaryId} { allow read, write: if isTenantStaff(shopId); }
      match /marketing_logs/{logId} { allow read, write: if isTenantStaff(shopId); }
    }

    // Legacy Client Collection (/clients/{clientId})
    match /clients/{clientId} {
      allow read: if isValidTenant(clientId);
      allow write: if isValidTenant(clientId);
      match /{allChildren=**} {
        allow read: if isValidTenant(clientId);
        allow write: if isValidTenant(clientId);
      }
    }
  }
}
