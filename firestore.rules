rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      allow read, write: if true;

      match /staff/{staffId} {
        allow read, write: if true;
      }
      match /customers/{customerId} {
        allow read, write: if true;
      }
      match /menu/{itemId} {
        allow read, write: if true;
      }
      match /tables/{tableId} {
        allow read, write: if true;
      }
      match /history/{orderId} {
        allow read, write: if true;
      }
      match /expenses/{expenseId} {
        allow read, write: if true;
      }
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
    match /clients/{clientId} {
      allow read, write: if true;

      match /staff/{staffId} {
        allow read, write: if true;
      }
      match /customers/{customerId} {
        allow read, write: if true;
      }
      match /menu/{itemId} {
        allow read, write: if true;
      }
      match /tables/{tableId} {
        allow read, write: if true;
      }
      match /history/{orderId} {
        allow read, write: if true;
      }
      match /expenses/{expenseId} {
        allow read, write: if true;
      }
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
